# Copy to .env.local and fill in. Restart `npm run dev` after changes.

# OpenAI — used by the question generator. Without it, lessons fall back to
# the seeded question bank.
OPENAI_API_KEY=

# Supabase — enables cloud auth (email + Google) and persistence of XP,
# streak, completed lessons, and daily-puzzle results. Settings → API in the
# Supabase dashboard. Leave blank to run in local-only (localStorage) mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
